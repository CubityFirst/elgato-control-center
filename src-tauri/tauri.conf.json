{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Elgato Control Center",
  "version": "1.0.0",
  "identifier": "local.elgato-control-center",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "popover",
        "title": "Elgato Lights",
        "url": "index.html",
        "width": 320,
        "height": 240,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "shadow": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "Elgato Control Center (mini)",
    "shortDescription": "Tray control for Elgato Key Lights",
    "longDescription": "A minimal tray popover for finding and controlling Elgato Key Lights: power, brightness and colour temperature.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh",
        "startMenuFolder": "Elgato Control Center",
        "displayLanguageSelector": false
      }
    }
  }
}